TRADING_MODE=PAPER
ALLOW_LIVE_TRADING=false
ALLOW_LEGACY_ADMIN_TOKEN=false
LIVE_ENABLE_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN
ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM_ADMIN_TOKEN
POSTGRES_DB=quant
POSTGRES_USER=quant
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DB_PASSWORD
API_PORT=8080
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+psycopg://quant:CHANGE_ME_LONG_RANDOM_DB_PASSWORD@postgres:5432/quant
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_SANDBOX=true
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_SANDBOX=true
MAX_ORDER_NOTIONAL_USD=100
MAX_DAILY_LOSS_USD=50
MAX_POSITION_NOTIONAL_USD=500

# Research/shadow only. These agents do not submit orders.
AGENT_COUNT=100
SHADOW_INTERVAL_SECONDS=60
BREAKOUT_PCT=10
BREAKDOWN_PCT=-10
MAX_OPPORTUNITIES_PER_CYCLE=100
# Read-only public spot market data; no exchange keys required for feeds
PUBLIC_MARKET_EXCHANGES=binance,kraken,coinbase
COINBASE_MAX_PRODUCTS=40
